{
  "title": "DevOps Operational Dashboard",
  "uid": "devops-operational",
  "tags": ["devops", "observability"],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "KPI Overview Bar",
      "type": "stat",
      "description": "Panel 1 per Design.md 4.2: Total Request Rate, Average Response Time, 5xx Error Rate, Active Pod Count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "Total Request Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_request_duration_seconds_sum[5m])) / sum(rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "Avg Response Time",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_requests_total{status=\"5xx\"}[2m])) / sum(rate(http_requests_total[2m])) * 100",
          "legendFormat": "5xx Error Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "sum(up{job=\"devops-monitored-app\"})",
          "legendFormat": "Active Pods",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Traffic & Latency Trends",
      "type": "timeseries",
      "description": "Panel 2 per Design.md 4.3: throughput split by status class and latency p50/p95/p99 from http_request_duration_seconds_bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=\"2xx\"}[5m]))",
          "legendFormat": "HTTP 200",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_total{status=\"5xx\"}[5m]))",
          "legendFormat": "HTTP 500",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Kubernetes Resource Utilization",
      "type": "gauge",
      "description": "Panel 3 per Design.md 4.4: CPU/Memory gauges and pod status. No Kubernetes infra series exist in this phase; queries use FastAPI process runtime series as placeholders. Runtime binding to kubelet/cAdvisor series deferred to Phase 10/11.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total[5m])",
          "legendFormat": "CPU usage (runtime placeholder; K8s binding deferred)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "Memory usage (runtime placeholder; K8s binding deferred)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(up{job=\"devops-monitored-app\"})",
          "legendFormat": "Pod status (deferred K8s restarts binding)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Live Application Log Stream",
      "type": "logs",
      "description": "Panel 4 per Design.md 4.5: LogQL stream for documented selector. Known Phase 10 dependency if B5 Fluent Bit does not establish the app label.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"devops-monitored-app\"} |= \"ERROR\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    }
  ]
}
